# ===========================================
# GEOSPEC - Source Code Tracking Enabled
# ===========================================

# Paper drafts (unpublished)
paper/

# Monitoring data and logs (large files)
# D2 freeze-lift 2026-08-13: monitoring/data/* (not the bare dir) so the calibration
# subdir can be negated -- capsule_registry.json + region capsules MUST be committed
# (externally-pinned calibration; see docs/INCIDENT_2026-07-31_component_artifacts.md).
monitoring/data/*
!monitoring/data/calibration/
monitoring/logs/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.vscode/
.idea/
*.swp

# Large data files
*.npz
*.tenv
*.tenv3

# Data directories
data/raw/
results/

# Cache
gps_cache/

# Database files
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db
.env
.env.local

# ===========================================
# EXCEPTIONS - Files that ARE committed
# ===========================================
